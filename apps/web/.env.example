# Copy to .env.local and fill in. Never commit real values.

# Supabase (public: the anon key is safe in the browser, RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend, no trailing slash, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=

# S3-compatible object storage for uploaded resumes (server only)
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# Temporary email/password demo sign-up page (/sign-up). Always on in development,
# OFF in production builds unless this is "true" at BUILD time.
# NEXT_PUBLIC_ENABLE_DEMO_SIGNUP=false
